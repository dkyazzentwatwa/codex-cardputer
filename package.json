{
  "name": "cardputer-codex-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @codexdeck/bridge dev",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage",
    "codex:compat": "node tools/generate-codex-schema.mjs --check",
    "firmware:build": "./tools/build-firmware.sh",
    "firmware:test:build": "./tools/build-firmware-tests.sh",
    "mac:build": "./tools/mac-swift.sh build",
    "mac:test": "./tools/mac-swift.sh test",
    "package:mac": "./tools/package-macos.sh",
    "mac:smoke": "./tools/test-macos-package.sh",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm mac:test && pnpm codex:compat && pnpm firmware:build && pnpm firmware:test:build"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.15",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  }
}
